---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config';
import { withBase } from '../utils/posts';

const skills = [
  '身体健康',
  '提高认知',
  '陪伴家人',
  '阅读',
  '写作',
  '记录',
];

// 结构化数据(GEO):作者信息,AI 搜索引用时带权威署名
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ProfilePage',
    mainEntity: {
      '@type': 'Person',
      name: SITE.author,
      description: '记录人生三大主线：身体健康、提高认知、陪伴家人',
      url: SITE.github,
      email: `mailto:${SITE.email}`,
      knowsAbout: skills,
    },
  },
];
---

<BaseLayout
  title="关于"
  description={`关于 ${SITE.author}`}
  jsonLd={jsonLd}
>
  <section class="mx-auto max-w-3xl px-5 pt-16 pb-24">
    <div data-hero>
      <p class="label-mono text-accent">// about me</p>
      <h1 class="mt-3 text-4xl font-black tracking-tight">关于我</h1>
    </div>

    <div class="mt-10 flex items-center gap-5" data-reveal>
      <div
        class="flex h-20 w-20 items-center justify-center rounded-2xl text-3xl font-black"
        style="background: var(--text); color: var(--bg)"
      >
        {SITE.author.slice(0, 1).toUpperCase()}
      </div>
      <div>
        <p class="text-xl font-bold">{SITE.author}</p>
        <p class="mt-1 text-sm text-muted">记录三大主线：身体健康 / 提高认知 / 陪伴家人</p>
      </div>
    </div>

    <div class="prose prose-blog mt-10" data-reveal>
      <p>
        你好,欢迎来到我的博客!我是
        {SITE.author}。这个博客是我的「人生记录本」:
        把三大主线上的实践和思考写下来,提醒自己别跑偏。
      </p>
      <p>
        这里的主题是<strong>身体健康</strong>、<strong>提高认知</strong>和
        <strong>陪伴家人</strong>,偶尔也会写点技术折腾。
        如果某篇文章恰好对你有用,那真是太好了;如果发现哪里写错了,欢迎在评论区指正。
      </p>
      <p><strong>在线项目：</strong></p>
      <ol>
        <li>
          课表 App：
          <a href="https://nbcckebiao.top" target="_blank" rel="noopener"
            >https://nbcckebiao.top</a
          >
        </li>
        <li>
          个人博客：<a href={withBase('/')}>xuhuohua.xyz</a>（你现在看的就是这个）
        </li>
        <li>正在开发中 ++——</li>
      </ol>
      <p>
        本站基于
        <a href="https://astro.build" target="_blank" rel="noopener">Astro</a>
        + TypeScript 构建,GitHub Actions 自动部署到 GitHub Pages。
        主题模板来自
        <a href="https://github.com/Ulysses-G-Yang/blog" target="_blank" rel="noopener">Ulysses Yang</a>
        ,在此致谢。
      </p>
    </div>

    <div class="mt-12" data-reveal>
      <h2 class="text-lg font-bold">关注方向</h2>
      <div class="mt-4 flex flex-wrap gap-2">
        {
          skills.map((skill) => (
            <span class="rounded-full border border-border bg-surface px-3.5 py-1.5 text-sm text-muted">
              {skill}
            </span>
          ))
        }
      </div>
    </div>

    <div class="mt-12" data-reveal>
      <h2 class="text-lg font-bold">找到我</h2>
      <div class="mt-4 flex flex-wrap gap-3">
        <a
          href={SITE.github}
          target="_blank"
          rel="noopener"
          class="btn-ghost">GitHub ↗</a
        >
        <a href={withBase('/feed.xml')} class="btn-ghost">RSS 订阅</a>
        <a href={`mailto:${SITE.email}`} class="btn-ghost">Email</a>
      </div>
    </div>

    <div class="mt-12" data-reveal>
      <h2 class="text-lg font-bold">站内导航</h2>
      <div class="mt-4 flex flex-wrap gap-3">
        <a href={withBase('/projects/')} class="btn-ghost">项目展示</a>
        <a href={withBase('/series/')} class="btn-ghost">系列专栏</a>
        <a href={withBase('/notes/')} class="btn-ghost">本周折腾</a>
        <a href={withBase('/guestbook/')} class="btn-ghost">留言板</a>
        <a href={withBase('/links/')} class="btn-ghost">友链</a>
        <a href={withBase('/contribute/')} class="btn-ghost">投稿指南</a>
      </div>
    </div>
  </section>
</BaseLayout>
