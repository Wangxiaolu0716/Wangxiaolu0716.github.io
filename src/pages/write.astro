---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="写作台"
  description="在浏览器里写文章、上传图片并提交到 GitHub"
  noindex
>
  <style>
    .wr-input,
    .wr-select,
    .wr-textarea {
      width: 100%;
      border: 1px solid var(--border);
      background: var(--bg);
      color: var(--text);
      border-radius: 0.75rem;
      padding: 0.55rem 0.75rem;
      font-size: 0.875rem;
      outline: none;
      transition: border-color 0.2s;
    }
    .wr-input:focus,
    .wr-select:focus,
    .wr-textarea:focus {
      border-color: var(--accent);
    }
    .wr-label {
      display: block;
      margin-bottom: 0.35rem;
      font-size: 0.75rem;
      font-weight: 600;
      color: var(--muted);
    }
    .wr-textarea {
      min-height: 55vh;
      font-family: var(--font-mono, ui-monospace, monospace);
      line-height: 1.7;
      resize: vertical;
    }
    .wr-tool {
      display: inline-flex;
      height: 1.9rem;
      min-width: 1.9rem;
      align-items: center;
      justify-content: center;
      gap: 0.25rem;
      border: 1px solid var(--border);
      border-radius: 0.5rem;
      background: var(--bg);
      color: var(--text);
      padding: 0 0.5rem;
      font-size: 0.75rem;
      line-height: 1;
      cursor: pointer;
      transition: border-color 0.15s, color 0.15s;
    }
    .wr-tool:hover {
      border-color: var(--accent);
      color: var(--accent);
    }
    .wr-tool input[type='color'] {
      width: 1.15rem;
      height: 1.15rem;
      padding: 0;
      border: none;
      background: none;
      cursor: pointer;
    }
  </style>

  <section class="mx-auto max-w-6xl px-5 pt-14 pb-24" id="write-app" data-hero>
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="label-mono text-accent">// write</p>
        <h1 class="mt-3 text-3xl font-black tracking-tight sm:text-4xl">
          写作台
        </h1>
        <p class="mt-2 text-sm text-muted">
          写完点发布，GitHub Actions 会自动更新 xuhuohua.xyz 和 GitHub Pages。
        </p>
      </div>
      <div
        id="auth-status"
        class="rounded-full border border-border px-3 py-1.5 text-xs text-muted"
      >
        未连接 GitHub
      </div>
    </div>

    <!-- Token 配置 -->
    <div class="mt-8 rounded-2xl border border-border bg-surface p-5">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <h2 class="text-sm font-bold">GitHub Token</h2>
        <span class="text-xs text-muted">只保存在本机浏览器</span>
      </div>
      <div class="mt-3 flex flex-col gap-2 sm:flex-row">
        <input
          id="token-input"
          type="password"
          class="wr-input flex-1"
          placeholder="粘贴 fine-grained token（Contents: Read and write）"
          autocomplete="off"
        />
        <button id="token-save" type="button" class="btn-primary shrink-0">
          保存
        </button>
        <button id="token-clear" type="button" class="btn-ghost shrink-0">
          清除
        </button>
      </div>
      <details class="mt-3 text-xs leading-relaxed text-muted">
        <summary class="cursor-pointer select-none">
          第一次用？点这里看 Token 创建步骤
        </summary>
        <ol class="mt-2 list-decimal space-y-1 pl-5">
          <li>
            打开
            <a
              class="text-accent hover:underline"
              href="https://github.com/settings/personal-access-tokens/new"
              target="_blank"
              rel="noopener">GitHub → Fine-grained tokens ↗</a
            >
          </li>
          <li>
            Repository access 选 Only select repositories，只勾选
            <code class="font-mono">Wangxiaolu0716.github.io</code>
          </li>
          <li>Permissions → Contents 设为 Read and write（Metadata 自动只读）</li>
          <li>生成后复制，粘贴到上面保存；手机和电脑各粘贴一次即可</li>
        </ol>
        <p class="mt-2">
          Token 只存在本机 localStorage，不会上传到服务器。设备不用了记得点「清除」，或去 GitHub 撤销。
        </p>
      </details>
    </div>

    <div class="mt-8 grid gap-6 lg:grid-cols-[300px_1fr]">
      <!-- 文章列表 -->
      <aside class="order-2 lg:order-1">
        <div class="rounded-2xl border border-border bg-surface p-4">
          <div class="flex items-center justify-between gap-2">
            <h2 class="text-sm font-bold">已有文章</h2>
            <button
              id="refresh-list"
              type="button"
              class="label-mono text-muted hover:text-accent"
            >
              刷新
            </button>
          </div>
          <div
            id="post-list"
            class="mt-3 max-h-[50vh] space-y-1 overflow-auto text-sm"
          >
            <p class="text-xs text-muted">加载中…</p>
          </div>
          <button id="new-post" type="button" class="btn-ghost mt-4 w-full">
            + 新建文章
          </button>
        </div>
      </aside>

      <!-- 编辑器 -->
      <div class="order-1 lg:order-2">
        <div id="editor-card" class="rounded-2xl border border-border bg-surface p-4 sm:p-5">
          <div
            id="local-draft-note"
            class="mb-4 hidden items-center justify-between gap-3 rounded-xl border border-accent/40 bg-accent/5 px-3 py-2 text-xs text-muted"
          >
            <span id="local-draft-text"></span>
            <button
              id="local-draft-ok"
              type="button"
              class="shrink-0 text-accent hover:underline"
            >
              知道了
            </button>
          </div>
          <div class="grid gap-4 sm:grid-cols-2">
            <label class="sm:col-span-2">
              <span class="wr-label">标题</span>
              <input id="f-title" class="wr-input" placeholder="文章标题" />
            </label>
            <label>
              <span class="wr-label">文件名 / 网址</span>
              <input
                id="f-slug"
                class="wr-input"
                placeholder="my-first-post"
                autocapitalize="off"
                spellcheck="false"
              />
            </label>
            <label>
              <span class="wr-label">发布日期</span>
              <input id="f-date" class="wr-input" type="date" />
            </label>
            <label class="sm:col-span-2">
              <span class="wr-label">摘要</span>
              <input
                id="f-desc"
                class="wr-input"
                placeholder="一句话摘要（列表、RSS、SEO 都用它）"
              />
            </label>
            <label class="sm:col-span-2">
              <span class="wr-label">定时发布时间（可选，填了再点「定时发布」）</span>
              <input id="f-scheduled" class="wr-input" type="datetime-local" />
            </label>
            <label>
              <span class="wr-label">分类</span>
              <select id="f-category" class="wr-select">
                <option value="essay">杂谈随笔</option>
                <option value="tech">技术分享</option>
              </select>
            </label>
            <label>
              <span class="wr-label">标签（逗号分隔）</span>
              <input id="f-tags" class="wr-input" placeholder="随笔, 记录" />
            </label>
            <label>
              <span class="wr-label">系列（可选）</span>
              <input id="f-series" class="wr-input" placeholder="留空即可" />
            </label>
            <label>
              <span class="wr-label">系列序号（可选）</span>
              <input
                id="f-order"
                class="wr-input"
                type="number"
                min="1"
                placeholder="1"
              />
            </label>
          </div>

          <div class="mt-4 flex flex-wrap items-center gap-3">
            <span
              id="state-badge"
              class="rounded-full border border-border px-2.5 py-1 font-mono text-[11px] text-muted"
            >
              新文章
            </span>
            <button id="upload-image" type="button" class="btn-ghost">
              插入图片
            </button>
            <input id="image-input" type="file" accept="image/*" class="hidden" />
            <button id="toggle-preview" type="button" class="btn-ghost">
              预览
            </button>
            <span id="editor-status" class="text-xs text-muted"></span>
          </div>

          <!-- 格式工具栏 -->
          <div
            id="format-toolbar"
            class="mt-4 flex flex-wrap items-center gap-1.5 rounded-xl border border-border bg-bg-soft p-2"
          >
            <button type="button" data-format="bold" class="wr-tool" title="加粗 (Ctrl+B)">
              <strong>B</strong>
            </button>
            <button type="button" data-format="italic" class="wr-tool" title="斜体 (Ctrl+I)">
              <em>I</em>
            </button>
            <button type="button" data-format="underline" class="wr-tool" title="下划线">
              <span class="underline">U</span>
            </button>
            <button type="button" data-format="strike" class="wr-tool" title="删除线">
              <span class="line-through">S</span>
            </button>
            <span class="mx-1 h-5 w-px bg-border" aria-hidden="true"></span>
            <button type="button" data-format="heading" class="wr-tool" title="二级标题">H2</button>
            <button type="button" data-format="quote" class="wr-tool" title="引用">引用</button>
            <button type="button" data-format="list" class="wr-tool" title="列表">列表</button>
            <button type="button" data-format="code" class="wr-tool" title="代码">代码</button>
            <span class="mx-1 h-5 w-px bg-border" aria-hidden="true"></span>
            <button type="button" data-format="link" class="wr-tool" title="超链接 (Ctrl+K)">链接</button>
            <input
              id="f-color"
              type="color"
              value="#c25d76"
              class="wr-tool"
              title="选择文字颜色"
            />
            <button type="button" data-format="color" class="wr-tool" title="给选中文字上色">上色</button>
            <button type="button" data-format="hr" class="wr-tool" title="分隔线">—</button>
          </div>

          <textarea
            id="f-body"
            class="wr-textarea mt-3"
            placeholder="正文用 Markdown 写……"
            spellcheck="false"
          ></textarea>

          <!-- Markdown 速查 -->
          <details class="mt-3 rounded-xl border border-border bg-bg-soft p-4 text-xs leading-relaxed text-muted">
            <summary class="cursor-pointer select-none font-semibold text-text">
              Markdown 写法速查（点开）
            </summary>
            <div class="mt-3 grid gap-x-6 gap-y-2 sm:grid-cols-2">
              <div><code>**加粗**</code> → <strong>加粗</strong></div>
              <div><code>*斜体*</code> → <em>斜体</em></div>
              <div><code>~~删除线~~</code> → <span class="line-through">删除线</span></div>
              <div><code>[文字](https://…)</code> → 超链接</div>
              <div><code>![说明](/images/x.png)</code> → 图片</div>
              <div><code>## 二级标题</code> → 小标题</div>
              <div><code>- 列表项</code> → 无序列表</div>
              <div><code>&gt; 引用</code> → 引用块</div>
              <div><code>`代码`</code> 或三个反引号 → 代码</div>
              <div><code>---</code> → 分隔线</div>
            </div>
            <p class="mt-3">
              下划线和颜色不是标准 Markdown，会用 HTML：
              <code>&lt;u&gt;文字&lt;/u&gt;</code>、
              <code>&lt;span style="color:#c25d76"&gt;文字&lt;/span&gt;</code>，工具栏会自动插入，不用手写。
            </p>
            <p class="mt-1">
              <a
                class="text-accent hover:underline"
                href="https://www.markdownguide.org/cheat-sheet/"
                target="_blank"
                rel="noopener">Markdown 官方速查表 ↗</a
              >
            </p>
          </details>

          <div
            id="preview-wrap"
            class="mt-4 hidden overflow-hidden rounded-2xl border border-border"
          ></div>

          <div class="mt-5 flex flex-wrap items-center gap-3 border-t border-border pt-4">
            <button id="save-draft" type="button" class="btn-ghost">
              存草稿（不发布）
            </button>
            <button id="schedule-publish" type="button" class="btn-ghost">
              定时发布
            </button>
            <button id="publish" type="button" class="btn-primary">
              发布
            </button>
            <span class="text-xs text-muted">
              草稿不会显示；定时文章到点后约 15 分钟内自动上线
            </span>
          </div>
          <div id="result-links" class="mt-3 flex flex-wrap gap-4 text-xs"></div>
        </div>
      </div>
    </div>
  </section>

  <script>
    import { marked } from 'marked';

    const OWNER = 'Wangxiaolu0716';
    const REPO = 'Wangxiaolu0716.github.io';
    const BRANCH = 'main';
    const API = 'https://api.github.com';
    const TOKEN_KEY = 'blog-write-token';
    const DRAFT_KEY = 'blog-write-local-draft';
    const SITE = 'https://xuhuohua.xyz';
    const BLOG_DIR = 'src/content/blog';

    marked.setOptions({ gfm: true, breaks: false });

    const today = (): string => new Date().toLocaleDateString('en-CA');

    const timeStamp = (): string => {
      const d = new Date();
      const two = (n: number) => String(n).padStart(2, '0');
      return `${d.getFullYear()}${two(d.getMonth() + 1)}${two(d.getDate())}-${two(d.getHours())}${two(d.getMinutes())}`;
    };

    const slugify = (s: string): string =>
      s
        .toLowerCase()
        .trim()
        .replace(/[^a-z0-9-]+/g, '-')
        .replace(/-+/g, '-')
        .replace(/^-|-$/g, '');

    const encodePath = (p: string): string =>
      p.split('/').map(encodeURIComponent).join('/');

    function bytesToBase64(bytes: Uint8Array): string {
      let bin = '';
      const chunk = 0x8000;
      for (let i = 0; i < bytes.length; i += chunk) {
        bin += String.fromCharCode(...bytes.subarray(i, i + chunk));
      }
      return btoa(bin);
    }

    function textToBase64(text: string): string {
      return bytesToBase64(new TextEncoder().encode(text));
    }

    function base64ToText(b64: string): string {
      const bin = atob(b64.replace(/\s/g, ''));
      const bytes = Uint8Array.from(bin, (c) => c.charCodeAt(0));
      return new TextDecoder().decode(bytes);
    }

    interface PostDraft {
      title: string;
      description: string;
      date: string;
      category: string;
      tags: string[];
      series: string;
      order: string;
      draft: boolean;
      body: string;
    }

    function unquote(v: string): string {
      const s = v.trim();
      if (s.startsWith('"') && s.endsWith('"')) {
        try {
          return JSON.parse(s);
        } catch {
          return s.slice(1, -1);
        }
      }
      if (s.startsWith("'") && s.endsWith("'")) return s.slice(1, -1);
      return s;
    }

    function parseFrontmatter(raw: string): {
      meta: Record<string, any>;
      body: string;
    } {
      const match = raw.match(/^\uFEFF?---\r?\n([\s\S]*?)\r?\n---\r?\n?/);
      if (!match) return { meta: {}, body: raw };
      const meta: Record<string, any> = {};
      for (const line of match[1].split(/\r?\n/)) {
        const t = line.trim();
        if (!t || t.startsWith('#')) continue;
        const idx = line.indexOf(':');
        if (idx < 0) continue;
        const key = line.slice(0, idx).trim();
        const val = line.slice(idx + 1).trim();
        if (!val) continue;
        if (key === 'tags') {
          meta.tags = unquote(val)
            .replace(/^\[|\]$/g, '')
            .split(',')
            .map((s) => unquote(s))
            .filter(Boolean);
        } else if (key === 'seriesOrder') {
          meta.seriesOrder = Number(unquote(val)) || 0;
        } else if (key === 'draft') {
          meta.draft = unquote(val) === 'true';
        } else {
          meta[key] = unquote(val);
        }
      }
      return { meta, body: raw.slice(match[0].length) };
    }

    function buildMarkdown(p: PostDraft, front: any): string {
      const lines = [
        '---',
        `title: ${JSON.stringify(p.title)}`,
        `description: ${JSON.stringify(p.description)}`,
        `pubDate: ${p.date}`,
      ];
      if (front.updatedDate) lines.push(`updatedDate: ${front.updatedDate}`);
      lines.push(`category: ${p.category}`);
      if (p.series) lines.push(`series: ${JSON.stringify(p.series)}`);
      if (p.order) lines.push(`seriesOrder: ${p.order}`);
      lines.push(
        `tags: [${p.tags.map((t) => JSON.stringify(t)).join(', ')}]`,
        `draft: ${p.draft}`,
        '---',
        '',
        p.body.trimEnd(),
        '',
      );
      return lines.join('\n');
    }

    function init(): void {
      const app = document.getElementById('write-app');
      if (!app || app.dataset.ready === '1') return;
      app.dataset.ready = '1';

      const $ = <T extends HTMLElement>(id: string): T =>
        document.getElementById(id) as T;

      const tokenInput = $<HTMLInputElement>('token-input');
      const tokenSave = $<HTMLButtonElement>('token-save');
      const tokenClear = $<HTMLButtonElement>('token-clear');
      const authEl = $<HTMLElement>('auth-status');
      const postList = $<HTMLElement>('post-list');
      const refreshBtn = $<HTMLButtonElement>('refresh-list');
      const newBtn = $<HTMLButtonElement>('new-post');
      const titleEl = $<HTMLInputElement>('f-title');
      const slugEl = $<HTMLInputElement>('f-slug');
      const dateEl = $<HTMLInputElement>('f-date');
      const scheduledEl = $<HTMLInputElement>('f-scheduled');
      const descEl = $<HTMLInputElement>('f-desc');
      const categoryEl = $<HTMLSelectElement>('f-category');
      const tagsEl = $<HTMLInputElement>('f-tags');
      const seriesEl = $<HTMLInputElement>('f-series');
      const orderEl = $<HTMLInputElement>('f-order');
      const bodyEl = $<HTMLTextAreaElement>('f-body');
      const formatToolbar = $<HTMLElement>('format-toolbar');
      const colorInput = $<HTMLInputElement>('f-color');
      const stateBadge = $<HTMLElement>('state-badge');
      const statusEl = $<HTMLElement>('editor-status');
      const uploadBtn = $<HTMLButtonElement>('upload-image');
      const imageInput = $<HTMLInputElement>('image-input');
      const previewBtn = $<HTMLButtonElement>('toggle-preview');
      const previewWrap = $<HTMLElement>('preview-wrap');
      const saveDraftBtn = $<HTMLButtonElement>('save-draft');
      const scheduleBtn = $<HTMLButtonElement>('schedule-publish');
      const publishBtn = $<HTMLButtonElement>('publish');
      const resultLinks = $<HTMLElement>('result-links');
      const editorCard = $<HTMLElement>('editor-card');
      const localDraftNote = $<HTMLElement>('local-draft-note');
      const localDraftText = $<HTMLElement>('local-draft-text');
      const localDraftOk = $<HTMLButtonElement>('local-draft-ok');

      let token = localStorage.getItem(TOKEN_KEY) ?? '';
      let currentPath = '';
      let currentSha = '';
      let currentUpdated = '';
      let slugTouched = false;
      let busy = false;
      let previewTimer: number | undefined;
      let persistTimer: number | undefined;
      let storageWarned = false;

      const setStatus = (msg: string, ok = true): void => {
        statusEl.textContent = msg;
        statusEl.className = `text-xs ${ok ? 'text-muted' : 'text-accent'}`;
      };

      const setAuth = (connected: boolean, label: string): void => {
        authEl.textContent = connected ? `已连接 ${label}` : label;
        authEl.className = `rounded-full border px-3 py-1.5 text-xs ${
          connected
            ? 'border-accent/40 text-accent'
            : 'border-border text-muted'
        }`;
      };

      const setBusy = (value: boolean): void => {
        busy = value;
        saveDraftBtn.disabled = value;
        scheduleBtn.disabled = value;
        publishBtn.disabled = value;
      };

      let dirty = false;

      /** 把 Date 转成 datetime-local 需要的本地格式 */
      const toLocalInput = (value: string | Date): string => {
        const d = new Date(value);
        if (Number.isNaN(d.getTime())) return '';
        const two = (n: number) => String(n).padStart(2, '0');
        return `${d.getFullYear()}-${two(d.getMonth() + 1)}-${two(d.getDate())}T${two(d.getHours())}:${two(d.getMinutes())}`;
      };

      const fmtTime = (value: string | Date): string => {
        const d = new Date(value);
        if (Number.isNaN(d.getTime())) return '时间无效';
        const two = (n: number) => String(n).padStart(2, '0');
        return `${d.getMonth() + 1}月${d.getDate()}日 ${two(d.getHours())}:${two(d.getMinutes())}`;
      };

      const fmtSavedAt = (ts: number): string => {
        const d = new Date(ts || Date.now());
        const two = (n: number) => String(n).padStart(2, '0');
        return `${d.getMonth() + 1}月${d.getDate()}日 ${two(d.getHours())}:${two(d.getMinutes())}`;
      };

      const editorSnapshot = () => ({
        title: titleEl.value,
        slug: slugEl.value,
        date: dateEl.value,
        scheduled: scheduledEl.value,
        desc: descEl.value,
        category: categoryEl.value,
        tags: tagsEl.value,
        series: seriesEl.value,
        order: orderEl.value,
        body: bodyEl.value,
        path: currentPath,
        sha: currentSha,
        updated: currentUpdated,
        at: Date.now(),
      });

      const hideLocalNote = (): void => {
        localDraftNote.classList.add('hidden');
        localDraftNote.classList.remove('flex');
      };

      const showLocalNote = (at: number): void => {
        localDraftText.textContent = `已恢复上次未保存的内容（${fmtSavedAt(at)}）。之后改动会自动保存在本机。`;
        localDraftNote.classList.remove('hidden');
        localDraftNote.classList.add('flex');
      };

      function persistNow(): void {
        if (!dirty) return;
        const snap = editorSnapshot();
        try {
          if (!snap.title.trim() && !snap.desc.trim() && !snap.body.trim()) {
            localStorage.removeItem(DRAFT_KEY);
            return;
          }
          localStorage.setItem(DRAFT_KEY, JSON.stringify(snap));
        } catch {
          if (!storageWarned) {
            storageWarned = true;
            setStatus('本机自动保存失败，请及时点发布', false);
          }
        }
      }

      function schedulePersist(): void {
        dirty = true;
        if (persistTimer) clearTimeout(persistTimer);
        persistTimer = window.setTimeout(persistNow, 400);
      }

      function clearLocalDraft(): void {
        localStorage.removeItem(DRAFT_KEY);
        if (persistTimer) clearTimeout(persistTimer);
        dirty = false;
        hideLocalNote();
      }

      function restoreLocalDraft(): boolean {
        const raw = localStorage.getItem(DRAFT_KEY);
        if (!raw) return false;
        try {
          const d = JSON.parse(raw) as Record<string, any>;
          if (!d || (!d.title && !d.desc && !d.body)) return false;
          titleEl.value = d.title ?? '';
          slugEl.value = d.slug || `post-${timeStamp()}`;
          dateEl.value = d.date || today();
          scheduledEl.value = d.scheduled ?? '';
          descEl.value = d.desc ?? '';
          categoryEl.value = d.category === 'tech' ? 'tech' : 'essay';
          tagsEl.value = d.tags ?? '';
          seriesEl.value = d.series ?? '';
          orderEl.value = d.order ?? '';
          bodyEl.value = d.body ?? '';
          currentPath = d.path ?? '';
          currentSha = d.sha ?? '';
          currentUpdated = d.updated ?? '';
          slugTouched = true;
          dirty = true;
          stateBadge.textContent = '本地草稿';
          showLocalNote(Number(d.at) || Date.now());
          return true;
        } catch {
          return false;
        }
      }

      async function gh(path: string, init?: RequestInit): Promise<any> {
        const res = await fetch(API + path, {
          ...init,
          headers: {
            Accept: 'application/vnd.github+json',
            Authorization: `Bearer ${token}`,
            'X-GitHub-Api-Version': '2022-11-28',
            ...(init?.headers ?? {}),
          },
        });
        if (!res.ok) {
          let msg = `${res.status} ${res.statusText}`;
          try {
            const j = await res.json();
            if (j?.message) msg = j.message;
          } catch {
            /* ignore */
          }
          const err = new Error(msg) as Error & { status?: number };
          err.status = res.status;
          throw err;
        }
        return res.json();
      }

      async function checkAuth(): Promise<void> {
        if (!token) {
          setAuth(false, '未连接 GitHub');
          return;
        }
        try {
          const me = await gh('/user');
          setAuth(true, `@${me.login}`);
        } catch (e: any) {
          setAuth(false, 'Token 无效或已过期');
          setStatus(e.message, false);
        }
      }

      type ListGroup = 'published' | 'scheduled' | 'draft';

      interface ListItem {
        path: string;
        name: string;
        title: string;
        sha: string;
        raw: string;
        meta: Record<string, any>;
        group: ListGroup;
      }

      let knownPosts: ListItem[] = [];
      let listRequestId = 0;

      async function mapLimit<T, R>(
        items: T[],
        limit: number,
        fn: (item: T) => Promise<R>,
      ): Promise<R[]> {
        const out = new Array<R>(items.length);
        let next = 0;
        const workers = Array.from(
          { length: Math.min(limit, items.length) },
          async () => {
            while (true) {
              const index = next++;
              if (index >= items.length) return;
              out[index] = await fn(items[index]);
            }
          },
        );
        await Promise.all(workers);
        return out;
      }

      async function fetchListItem(file: any): Promise<ListItem | null> {
        try {
          const data = await gh(
            `/repos/${OWNER}/${REPO}/contents/${encodePath(file.path)}?ref=${BRANCH}`,
          );
          const raw = base64ToText(data.content);
          const { meta } = parseFrontmatter(raw);
          const pub = new Date(String(meta.pubDate ?? ''));
          const future =
            !meta.draft &&
            !Number.isNaN(pub.getTime()) &&
            pub.getTime() > Date.now();
          return {
            path: file.path,
            name: file.name,
            title: meta.title || file.name.replace(/\.md$/, ''),
            sha: data.sha,
            raw,
            meta,
            group: meta.draft ? 'draft' : future ? 'scheduled' : 'published',
          };
        } catch {
          return null;
        }
      }

      function renderGroups(items: ListItem[]): void {
        postList.innerHTML = '';
        if (!items.length) {
          const empty = document.createElement('p');
          empty.className = 'text-xs text-muted';
          empty.textContent = '还没有文章。';
          postList.appendChild(empty);
          return;
        }
        const published = items
          .filter((i) => i.group === 'published')
          .sort(
            (a, b) =>
              new Date(String(b.meta.pubDate)).getTime() -
              new Date(String(a.meta.pubDate)).getTime(),
          );
        const scheduled = items
          .filter((i) => i.group === 'scheduled')
          .sort(
            (a, b) =>
              new Date(String(a.meta.pubDate)).getTime() -
              new Date(String(b.meta.pubDate)).getTime(),
          );
        const drafts = items
          .filter((i) => i.group === 'draft')
          .sort((a, b) => b.name.localeCompare(a.name));

        const renderGroup = (
          label: string,
          groupItems: ListItem[],
          first: boolean,
          withDelete: boolean,
        ) => {
          if (!groupItems.length) return;
          const heading = document.createElement('p');
          heading.className = `label-mono text-[11px] text-muted ${first ? '' : 'mt-4'}`;
          heading.textContent = `${label}  ${groupItems.length}`;
          postList.appendChild(heading);

          const wrap = document.createElement('div');
          wrap.className = 'mt-1.5 space-y-0.5';
          for (const item of groupItems) {
            const row = document.createElement('div');
            row.className = 'flex items-center gap-1';

            const main = document.createElement('button');
            main.type = 'button';
            main.className =
              'min-w-0 flex-1 rounded-lg px-2 py-1.5 text-left transition-colors hover:bg-bg-soft';
            main.title = item.name;
            const title = document.createElement('span');
            title.className =
              'block truncate text-sm font-medium text-text';
            title.textContent = item.title;
            const sub = document.createElement('span');
            sub.className =
              'mt-0.5 block truncate font-mono text-[11px] text-muted';
            sub.textContent =
              item.group === 'scheduled'
                ? `${fmtTime(String(item.meta.pubDate))} · ${item.name}`
                : item.name;
            main.append(title, sub);
            main.addEventListener('click', () => void loadPost(item.path));
            row.appendChild(main);

            if (withDelete) {
              const del = document.createElement('button');
              del.type = 'button';
              del.className =
                'shrink-0 rounded px-1.5 py-1 text-[11px] text-muted transition-colors hover:text-accent';
              del.title = '删除草稿';
              del.textContent = '删除';
              del.addEventListener('click', () => void deleteDraft(item));
              row.appendChild(del);
            }
            wrap.appendChild(row);
          }
          postList.appendChild(wrap);
        };

        renderGroup('已发布', published, true, false);
        renderGroup('定时发布', scheduled, published.length === 0, false);
        renderGroup(
          '草稿',
          drafts,
          published.length === 0 && scheduled.length === 0,
          true,
        );
      }

      async function deleteDraft(item: ListItem): Promise<void> {
        if (!token) {
          setStatus('先保存 GitHub Token', false);
          return;
        }
        if (
          !confirm(
            `删除草稿「${item.title || item.name}」？删除后不可恢复。`,
          )
        ) {
          return;
        }
        try {
          setStatus('正在删除草稿…');
          await gh(
            `/repos/${OWNER}/${REPO}/contents/${encodePath(item.path)}`,
            {
              method: 'DELETE',
              body: JSON.stringify({
                message: `删除草稿: ${item.name}`,
                sha: item.sha,
                branch: BRANCH,
              }),
            },
          );
          knownPosts = knownPosts.filter((i) => i.path !== item.path);
          if (currentPath === item.path) {
            resetEditor();
            clearLocalDraft();
          }
          setStatus('草稿已删除');
          void loadList();
        } catch (e: any) {
          setStatus(`删除失败：${e.message}`, false);
        }
      }

      async function loadList(): Promise<void> {
        if (!token) {
          postList.innerHTML = '';
          const tip = document.createElement('p');
          tip.className = 'text-xs text-muted';
          tip.textContent = '先保存 GitHub Token 才能读取文章列表。';
          postList.appendChild(tip);
          return;
        }
        postList.innerHTML = '';
        const loading = document.createElement('p');
        loading.className = 'text-xs text-muted';
        loading.textContent = '加载中…';
        postList.appendChild(loading);
        const requestId = ++listRequestId;
        try {
          const files = await gh(
            `/repos/${OWNER}/${REPO}/contents/${BLOG_DIR}?ref=${BRANCH}`,
          );
          const listFiles = (Array.isArray(files) ? files : []).filter(
            (f: any) =>
              f.type === 'file' &&
              f.name.endsWith('.md') &&
              !f.name.startsWith('_'),
          );
          const fetched = await mapLimit(listFiles, 4, fetchListItem);
          if (requestId !== listRequestId) return;
          knownPosts = fetched.filter(Boolean) as ListItem[];
          renderGroups(knownPosts);
        } catch (e: any) {
          if (requestId !== listRequestId) return;
          postList.innerHTML = '';
          const err = document.createElement('p');
          err.className = 'text-xs text-accent';
          err.textContent = e.message;
          postList.appendChild(err);
        }
      }

      async function loadPost(path: string): Promise<void> {
        if (dirty && !confirm('当前有未保存的内容，载入其他文章会覆盖它，确定吗？')) {
          return;
        }
        try {
          setStatus('正在读取…');
          let raw = '';
          let sha = '';
          const cached = knownPosts.find((p) => p.path === path);
          if (cached) {
            raw = cached.raw;
            sha = cached.sha;
          } else {
            const data = await gh(
              `/repos/${OWNER}/${REPO}/contents/${encodePath(path)}?ref=${BRANCH}`,
            );
            raw = base64ToText(data.content);
            sha = data.sha;
          }
          const parsed = parseFrontmatter(raw);
          const meta = parsed.meta;
          const pub = new Date(String(meta.pubDate ?? ''));
          const pubValid = !Number.isNaN(pub.getTime());
          const future =
            !meta.draft && pubValid && pub.getTime() > Date.now();
          titleEl.value = meta.title ?? '';
          slugEl.value = (path.split('/').pop() ?? '').replace(/\.md$/, '');
          dateEl.value = pubValid
            ? toLocalInput(pub).slice(0, 10)
            : today();
          scheduledEl.value = future ? toLocalInput(pub) : '';
          descEl.value = meta.description ?? '';
          categoryEl.value = meta.category === 'tech' ? 'tech' : 'essay';
          tagsEl.value = Array.isArray(meta.tags) ? meta.tags.join(', ') : '';
          seriesEl.value = meta.series ?? '';
          orderEl.value = meta.seriesOrder ? String(meta.seriesOrder) : '';
          bodyEl.value = parsed.body;
          currentPath = path;
          currentSha = sha;
          currentUpdated = meta.updatedDate ?? '';
          slugTouched = true;
          stateBadge.textContent = meta.draft
            ? '草稿（未发布）'
            : future
              ? `定时发布 · ${fmtTime(pub)}`
              : '已发布';
          resultLinks.innerHTML = '';
          clearLocalDraft();
          setStatus('已载入，修改后点保存');
          bodyEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
        } catch (e: any) {
          setStatus(e.message, false);
        }
      }

      function newPost(): void {
        if (dirty && !confirm('当前有未保存的内容，新建会覆盖它，确定吗？')) {
          return;
        }
        resetEditor();
        clearLocalDraft();
        setStatus('已新建，可以开始写');
        titleEl.focus();
      }

      function resetEditor(): void {
        currentPath = '';
        currentSha = '';
        currentUpdated = '';
        slugTouched = false;
        dirty = false;
        titleEl.value = '';
        slugEl.value = `post-${timeStamp()}`;
        dateEl.value = today();
        scheduledEl.value = '';
        descEl.value = '';
        categoryEl.value = 'essay';
        tagsEl.value = '';
        seriesEl.value = '';
        orderEl.value = '';
        bodyEl.value = '## 背景\n\n\n## 正文\n\n\n## 总结\n';
        stateBadge.textContent = '新文章';
        resultLinks.innerHTML = '';
      }

      function collect(): PostDraft | null {
        const title = titleEl.value.trim();
        const slug = slugify(slugEl.value);
        const description = descEl.value.trim();
        const date = dateEl.value;
        if (!title) {
          setStatus('标题不能为空', false);
          return null;
        }
        if (!slug) {
          setStatus('文件名不能为空，建议用英文或拼音', false);
          return null;
        }
        if (!description) {
          setStatus('摘要不能为空', false);
          return null;
        }
        if (!/^\d{4}-\d{2}-\d{2}$/.test(date)) {
          setStatus('发布日期格式不对', false);
          return null;
        }
        slugEl.value = slug;
        return {
          title,
          description,
          date,
          category: categoryEl.value === 'tech' ? 'tech' : 'essay',
          tags: tagsEl.value
            .split(/[,，]/)
            .map((s) => s.trim())
            .filter(Boolean),
          series: seriesEl.value.trim(),
          order: orderEl.value.trim(),
          draft: false,
          body: bodyEl.value,
        };
      }

      async function save(
        mode: 'draft' | 'publish' | 'schedule',
      ): Promise<void> {
        if (busy) return;
        if (!token) {
          setStatus('先保存 GitHub Token', false);
          return;
        }
        const post = collect();
        if (!post) return;
        const publishing = mode === 'publish';
        const scheduling = mode === 'schedule';
        if (scheduling) {
          if (!scheduledEl.value) {
            setStatus('先填「定时发布时间」', false);
            return;
          }
          const when = new Date(scheduledEl.value);
          if (
            Number.isNaN(when.getTime()) ||
            when.getTime() <= Date.now() + 60 * 1000
          ) {
            setStatus('定时时间要晚于现在至少 1 分钟', false);
            return;
          }
          post.date = when.toISOString();
          post.draft = false;
          dateEl.value = toLocalInput(when).slice(0, 10);
        } else {
          post.draft = !publishing;
        }
        const finalPath = `${BLOG_DIR}/${slugEl.value.trim()}.md`;
        const apiPath = encodePath(finalPath);
        setBusy(true);
        setStatus(
          scheduling
            ? '正在定时…'
            : publishing
              ? '正在发布…'
              : '正在存草稿…',
        );
        try {
          let sha = finalPath === currentPath ? currentSha : '';
          let existed = false;
          if (!sha) {
            try {
              const existing = await gh(
                `/repos/${OWNER}/${REPO}/contents/${apiPath}?ref=${BRANCH}`,
              );
              sha = existing.sha;
              existed = true;
            } catch (e: any) {
              if (e.status !== 404) throw e;
            }
          }
          if (existed && finalPath !== currentPath) {
            if (!confirm('这个文件名已经存在，要覆盖它吗？')) {
              setStatus('已取消');
              return;
            }
          }
          const payload: any = {
            message: `${
              scheduling ? '定时发布' : publishing ? '发布' : '保存草稿'
            }: ${post.title}`,
            content: textToBase64(
              buildMarkdown(post, { updatedDate: currentUpdated }),
            ),
            branch: BRANCH,
          };
          if (sha) payload.sha = sha;
          const res = await gh(
            `/repos/${OWNER}/${REPO}/contents/${apiPath}`,
            { method: 'PUT', body: JSON.stringify(payload) },
          );
          currentPath = finalPath;
          currentSha = res.content.sha;
          clearLocalDraft();
          stateBadge.textContent = scheduling
            ? `定时发布 · ${fmtTime(post.date)}`
            : publishing
              ? '已发布'
              : '草稿（未发布）';
          resultLinks.innerHTML = '';
          const ghLink = document.createElement('a');
          ghLink.href = `https://github.com/${OWNER}/${REPO}/blob/${BRANCH}/${finalPath}`;
          ghLink.target = '_blank';
          ghLink.rel = 'noopener';
          ghLink.className = 'text-accent hover:underline';
          ghLink.textContent = '在 GitHub 查看 ↗';
          resultLinks.append(ghLink);
          if (publishing) {
            const siteLink = document.createElement('a');
            siteLink.href = `${SITE}/blog/${slugEl.value.trim()}/`;
            siteLink.target = '_blank';
            siteLink.rel = 'noopener';
            siteLink.className = 'text-accent hover:underline';
            siteLink.textContent = '打开线上文章（约 2 分钟后生效）↗';
            resultLinks.append(siteLink);
          } else if (scheduling) {
            const hint = document.createElement('span');
            hint.className = 'text-accent';
            hint.textContent = `将于 ${fmtTime(post.date)} 自动上线（每 15 分钟构建一次）`;
            resultLinks.append(hint);
          } else {
            const hint = document.createElement('span');
            hint.className = 'text-muted';
            hint.textContent = '草稿已保存到 GitHub，网站上不会显示';
            resultLinks.append(hint);
          }
          setStatus(
            publishing
              ? '已发布，等待自动部署'
              : scheduling
                ? `已定时：${fmtTime(post.date)}`
                : '草稿已保存到 GitHub',
          );
          void loadList();
        } catch (e: any) {
          setStatus(`保存失败：${e.message}`, false);
        } finally {
          setBusy(false);
        }
      }

      async function uploadImage(file: File): Promise<void> {
        if (!token) {
          setStatus('先保存 GitHub Token', false);
          return;
        }
        if (file.size > 10 * 1024 * 1024) {
          setStatus('图片超过 10MB，请压缩后再传', false);
          return;
        }
        const ext =
          (file.name.split('.').pop() ?? 'png')
            .toLowerCase()
            .replace(/[^a-z0-9]/g, '') || 'png';
        const base =
          file.name
            .replace(/\.[^.]+$/, '')
            .toLowerCase()
            .replace(/[^a-z0-9]+/g, '-')
            .replace(/^-+|-+$/g, '') || 'image';
        const name = `${base}-${Date.now().toString(36)}.${ext}`;
        const path = `public/images/${name}`;
        setStatus('正在上传图片…');
        try {
          const bytes = new Uint8Array(await file.arrayBuffer());
          await gh(
            `/repos/${OWNER}/${REPO}/contents/${encodePath(path)}`,
            {
              method: 'PUT',
              body: JSON.stringify({
                message: `上传图片: ${name}`,
                content: bytesToBase64(bytes),
                branch: BRANCH,
              }),
            },
          );
          insertAtCursor(`\n![${base}](/images/${name})\n`);
          setStatus('图片已上传并插入正文');
        } catch (e: any) {
          setStatus(`图片上传失败：${e.message}`, false);
        }
      }

      function insertAtCursor(text: string): void {
        const start = bodyEl.selectionStart ?? bodyEl.value.length;
        const end = bodyEl.selectionEnd ?? start;
        bodyEl.value =
          bodyEl.value.slice(0, start) + text + bodyEl.value.slice(end);
        bodyEl.focus();
        const pos = start + text.length;
        bodyEl.setSelectionRange(pos, pos);
        schedulePersist();
      }

      function selectionRange(): {
        start: number;
        end: number;
        text: string;
      } {
        const start = bodyEl.selectionStart ?? 0;
        const end = bodyEl.selectionEnd ?? start;
        return { start, end, text: bodyEl.value.slice(start, end) };
      }

      function replaceRange(
        start: number,
        end: number,
        text: string,
        selectStart?: number,
        selectEnd?: number,
      ): void {
        bodyEl.value =
          bodyEl.value.slice(0, start) + text + bodyEl.value.slice(end);
        bodyEl.focus();
        const a = selectStart ?? start + text.length;
        const b = selectEnd ?? a;
        bodyEl.setSelectionRange(a, b);
        schedulePersist();
      }

      function wrapSelection(
        before: string,
        after: string,
        placeholder: string,
      ): void {
        const { start, end, text } = selectionRange();
        const inner = text || placeholder;
        replaceRange(
          start,
          end,
          before + inner + after,
          start + before.length,
          start + before.length + inner.length,
        );
      }

      /** 给当前行或选中行统一加前缀(引用/列表/标题用) */
      function prefixLines(prefix: string): void {
        const { start, end } = selectionRange();
        const lineStart = bodyEl.value.lastIndexOf('\n', start - 1) + 1;
        let blockEnd = end === start ? bodyEl.value.indexOf('\n', start) : end;
        if (blockEnd < 0) blockEnd = bodyEl.value.length;
        const block = bodyEl.value.slice(lineStart, blockEnd);
        if (!block) {
          insertAtCursor(prefix);
          return;
        }
        const next = block
          .split('\n')
          .map((line) => prefix + line)
          .join('\n');
        replaceRange(lineStart, blockEnd, next, lineStart, lineStart + next.length);
      }

      function applyFormat(action: string): void {
        switch (action) {
          case 'bold':
            wrapSelection('**', '**', '加粗文字');
            break;
          case 'italic':
            wrapSelection('*', '*', '斜体文字');
            break;
          case 'underline':
            wrapSelection('<u>', '</u>', '下划线文字');
            break;
          case 'strike':
            wrapSelection('~~', '~~', '删除线文字');
            break;
          case 'link': {
            const sel = selectionRange();
            const url = prompt('链接地址（含 https://）', 'https://');
            if (!url) return;
            const inner = sel.text || '链接文字';
            replaceRange(
              sel.start,
              sel.end,
              `[${inner}](${url})`,
              sel.start + 1,
              sel.start + 1 + inner.length,
            );
            break;
          }
          case 'color':
            wrapSelection(
              `<span style="color:${colorInput.value}">`,
              '</span>',
              '彩色文字',
            );
            break;
          case 'hr':
            insertAtCursor('\n\n---\n\n');
            break;
          case 'heading':
            prefixLines('## ');
            break;
          case 'quote':
            prefixLines('> ');
            break;
          case 'list':
            prefixLines('- ');
            break;
          case 'code': {
            const { text } = selectionRange();
            if (text.includes('\n')) wrapSelection('\n```\n', '\n```\n', '');
            else wrapSelection('`', '`', '代码');
            break;
          }
        }
      }

      /** 重新渲染预览:每次换一个新的 iframe,避免某些浏览器
          在隐藏状态下写入 srcdoc 后显示为空白。 */
      function renderPreview(): void {
        const html = marked.parse(bodyEl.value || '') as string;
        const frame = document.createElement('iframe');
        frame.className = 'h-[60vh] w-full bg-white';
        frame.setAttribute('sandbox', '');
        frame.srcdoc = `<!doctype html><html><head><meta charset="utf-8"><style>
            body{margin:0;padding:28px;background:#fff;color:#1d1a24;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","Microsoft YaHei",sans-serif;line-height:1.75;font-size:15px}
            h1,h2,h3{line-height:1.3;margin:1.4em 0 .6em}
            h1{font-size:1.7em}h2{font-size:1.35em}h3{font-size:1.15em}
            p{margin:.8em 0}
            a{color:#c25d76}
            img{max-width:100%;border-radius:10px}
            pre{background:#f5f2f6;padding:14px;border-radius:10px;overflow:auto;font-size:13px}
            code{font-family:ui-monospace,Consolas,monospace;background:#f5f2f6;padding:.15em .35em;border-radius:4px}
            pre code{padding:0;background:none}
            blockquote{margin:1em 0;padding-left:14px;border-left:3px solid #c25d76;color:#6e6580}
            ul,ol{padding-left:1.4em}
            table{border-collapse:collapse}th,td{border:1px solid #ddd;padding:.4em .7em}
          </style></head><body>${html}</body></html>`;
        previewWrap.replaceChildren(frame);
      }

      function togglePreview(): void {
        const hidden = previewWrap.classList.contains('hidden');
        if (hidden) {
          // 先显示容器再渲染,顺序不能反
          previewWrap.classList.remove('hidden');
          previewBtn.textContent = '返回编辑';
          requestAnimationFrame(renderPreview);
        } else {
          previewWrap.classList.add('hidden');
          previewBtn.textContent = '预览';
          if (previewTimer) clearTimeout(previewTimer);
        }
      }

      // ===== 事件绑定 =====
      tokenSave.addEventListener('click', () => {
        const value = tokenInput.value.trim();
        if (!value) {
          setStatus('请先粘贴 Token', false);
          return;
        }
        token = value;
        localStorage.setItem(TOKEN_KEY, value);
        tokenInput.value = '';
        setStatus('Token 已保存');
        void checkAuth();
        void loadList();
      });

      tokenClear.addEventListener('click', () => {
        token = '';
        localStorage.removeItem(TOKEN_KEY);
        tokenInput.value = '';
        setAuth(false, '未连接 GitHub');
        setStatus('Token 已清除');
        void loadList();
      });

      refreshBtn.addEventListener('click', () => void loadList());
      newBtn.addEventListener('click', newPost);
      saveDraftBtn.addEventListener('click', () => void save('draft'));
      scheduleBtn.addEventListener('click', () => void save('schedule'));
      publishBtn.addEventListener('click', () => void save('publish'));
      previewBtn.addEventListener('click', togglePreview);
      // 预览开着时,正文改动 250ms 后自动刷新预览
      bodyEl.addEventListener('input', () => {
        if (previewWrap.classList.contains('hidden')) return;
        if (previewTimer) clearTimeout(previewTimer);
        previewTimer = window.setTimeout(renderPreview, 250);
      });

      // 表单任何输入都自动存本机(400ms 防抖)
      editorCard.addEventListener('input', schedulePersist);
      editorCard.addEventListener('change', schedulePersist);
      localDraftOk.addEventListener('click', hideLocalNote);
      // 关闭标签页/切到后台时立刻落盘,避免来不及防抖
      window.addEventListener('pagehide', persistNow);
      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'hidden') persistNow();
      });
      uploadBtn.addEventListener('click', () => imageInput.click());
      imageInput.addEventListener('change', () => {
        const file = imageInput.files?.[0];
        if (file) void uploadImage(file);
        imageInput.value = '';
      });

      // 点工具栏按钮时别让 textarea 失焦，保留选区
      formatToolbar.addEventListener('mousedown', (event) => {
        const target = event.target as HTMLElement;
        if (target.closest('[data-format]')) event.preventDefault();
      });
      formatToolbar.addEventListener('click', (event) => {
        const btn = (event.target as HTMLElement).closest<HTMLElement>(
          '[data-format]',
        );
        if (!btn) return;
        applyFormat(btn.dataset.format ?? '');
      });
      bodyEl.addEventListener('keydown', (event) => {
        if (!(event.ctrlKey || event.metaKey)) return;
        const key = event.key.toLowerCase();
        if (key === 'b') {
          event.preventDefault();
          applyFormat('bold');
        } else if (key === 'i') {
          event.preventDefault();
          applyFormat('italic');
        } else if (key === 'k') {
          event.preventDefault();
          applyFormat('link');
        }
      });

      slugEl.addEventListener('input', () => {
        slugTouched = true;
      });
      titleEl.addEventListener('input', () => {
        if (slugTouched) return;
        const s = slugify(titleEl.value);
        slugEl.value = s || `post-${timeStamp()}`;
      });

      // ===== 初始化 =====
      resetEditor();
      const restored = restoreLocalDraft();
      setStatus(restored ? '已恢复上次未保存的内容' : '已新建，可以开始写');
      if (token) {
        void checkAuth();
        void loadList();
      } else {
        void loadList();
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init, { once: true });
    } else {
      init();
    }
    document.addEventListener('astro:page-load', init);
  </script>
</BaseLayout>
